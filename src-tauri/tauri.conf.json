{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LECAA Docs",
  "version": "0.5.0",
  "identifier": "cat.ub.utac.lecaadocs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "LECAA Docs", "width": 1200, "height": 860, "minWidth": 380, "minHeight": 520 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Processador de textos amb text a veu per aprendre a escriure",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
